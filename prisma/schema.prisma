generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Profile {
  REAL
  HUMAN
  TECH
}

enum ExamSession {
  SUMMER
  AUTUMN
  SPECIAL
}

enum QuestionType {
  SINGLE
  CLOZE
  FLASHCARD
  DRAG_DROP
}

enum UnitType {
  LESSON
  RECAP
  CHECKPOINT
  DIAGNOSTIC
}

enum UnitStatusEnum {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  MASTERED
  NEEDS_REVIEW
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String?  @unique
  passwordHash  String
  name          String
  image         String?
  emailVerified DateTime?
  role          Role     @default(USER)
  streakCount   Int      @default(0)
  lastActiveAt  DateTime?
  timezone      String?
  dashboardWidgets Json?
  weatherLocation Json?
  themeSlug     String?
  profile       Profile?
  emailNotifs   Boolean  @default(true)
  streakNotifs  Boolean  @default(true)
  followNotifs  Boolean  @default(true)
  termsAcceptedAt DateTime?
  onboardingDone Boolean @default(false)
  googleLinked  Boolean @default(false)
  googleEmail   String?  @unique
  pendingEmail  String?
  pendingEmailCode DateTime?
  pendingEmailExpires DateTime?
  reminderHour  Int?
  streakWarnedFor DateTime?
  reminderSentOn DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lessonProgress      LessonProgress[]
  lessonStepProgress  LessonStepProgress[]
  quizAttempts        QuizAttempt[]
  pushSubscriptions   PushSubscription[]
  calendarEvents      CalendarEvent[]
  quizzes             Quiz[]
  todoItems           TodoItem[]
  studyActivities     StudyActivity[]
  reviewItems         ReviewItem[]
  conceptProgress     UserConceptProgress[]
  unitProgress        UserUnitProgress[]
  checkpointAttempts  CheckpointAttempt[]
  following           Follow[] @relation("Follower")
  followers           Follow[] @relation("Following")
}

// Urmărire unidirecțională: `follower` urmărește `following`.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  light       Json
  dark        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventKind {
  USER
  ACHIEVEMENT
  EXAM
}

model CalendarEvent {
  id        String    @id @default(cuid())
  userId    String
  title     String
  date      DateTime
color     String?
    kind      EventKind @default(USER)
    key       String?
    createdAt DateTime  @default(now())
  
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
    @@unique([userId, key])
    @@index([userId, date])
}

model Subject {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  color       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  chapters      Chapter[]
  quizzes       Quiz[]
  exams         OfficialExam[]
  subjectProfiles SubjectProfile[]
}

model SubjectProfile {
  id        String   @id @default(cuid())
  subjectId String
  profile   Profile

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, profile])
}

model Chapter {
  id          String  @id @default(cuid())
  subjectId   String
  title       String
  slug        String
  description String?
  order       Int     @default(0)

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  units   Unit[]
  quizzes Quiz[]
  checkpoints Checkpoint[]

  @@unique([subjectId, slug])
}

model Unit {
  id          String   @id @default(cuid())
  chapterId   String
  title       String
  slug        String
  description String?
  order       Int      @default(0)
  type        UnitType @default(LESSON)

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  concepts Concept[]
  checkpoint Checkpoint?
  progress UserUnitProgress[]

  @@unique([chapterId, slug])
  @@index([chapterId])
}

model Lesson {
  id        String  @id @default(cuid())
  chapterId String
  unitId    String?
  title     String
  slug      String
  content   String
  videoUrl  String?
  pdfUrl    String?
  order     Int     @default(0)

  chapter  Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  unit     Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  progress LessonProgress[]
  steps    LessonStep[]
  concepts Concept[]

  @@unique([chapterId, slug])
  @@index([unitId])
}

model LessonStep {
  id        String  @id @default(cuid())
  lessonId  String
  title     String?
  content   String
  order     Int     @default(0)
  stepType  String? // DESCOPERĂ, ÎNȚELEGE, EXEMPLU, ÎNCEARCĂ, EXERSEAZĂ, APLICĂ, RECAPITULEAZĂ
  quizId    String? @unique

  lesson   Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quiz     Quiz?           @relation(fields: [quizId], references: [id], onDelete: SetNull)
  progress LessonStepProgress[]

  @@unique([lessonId, order])
  @@index([lessonId])
}

model LessonStepProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  stepId    String
  completedAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  step LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId, lessonId])
  @@index([completedAt])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([completedAt])
}

model Concept {
  id          String  @id @default(cuid())
  lessonId    String?
  unitId      String?
  name        String
  slug        String
  description String?
  difficulty  Int     @default(1)
  order       Int     @default(0)

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  exercises Exercise[]
  questions Question[]
  progress  UserConceptProgress[]

  @@unique([lessonId, slug])
  @@unique([unitId, slug])
  @@index([lessonId])
  @@index([unitId])
}

model Exercise {
  id        String       @id @default(cuid())
  conceptId String
  type      QuestionType @default(SINGLE)
  difficulty Int         @default(1)
  content   Json
  answer    Json
  explanation String?
  order     Int          @default(0)
  createdAt DateTime     @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([conceptId])
}

model UserConceptProgress {
  id              String    @id @default(cuid())
  userId          String
  conceptId       String
  mastery         Int       @default(0)
  attempts        Int       @default(0)
  correctAttempts Int       @default(0)
  wrongAttempts   Int       @default(0)
  lastPracticed   DateTime?
  nextReview      DateTime?
  updatedAt       DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId, mastery])
  @@index([userId, nextReview])
}

model UserUnitProgress {
  id          String   @id @default(cuid())
  userId      String
  unitId      String
  status      String   @default("LOCKED")
  progress    Int      @default(0)
  score       Int?
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId])
}

model Checkpoint {
  id        String   @id @default(cuid())
  chapterId String? @unique
  unitId    String? @unique
  title     String
  slug      String  @unique
  order     Int     @default(0)
  createdAt DateTime @default(now())

  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  unit    Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  attempts CheckpointAttempt[]
}

model CheckpointAttempt {
  id           String   @id @default(cuid())
  userId       String
  checkpointId String
  score        Int
  maxScore     Int
  answers      Json
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([checkpointId])
}

model Quiz {
    id          String   @id @default(cuid())
    subjectId   String
    chapterId   String?
    userId      String?
    title       String
    slug        String
    description String?
    difficulty  Int      @default(1)
    published   Boolean  @default(true)
    order       Int      @default(0)
    createdAt   DateTime @default(now())
  
    subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
    chapter   Chapter?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
    user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    questions Question[]
    attempts  QuizAttempt[]
    step      LessonStep?
  
    @@index([userId])
    @@unique([subjectId, slug])
  }

model Question {
  id           String       @id @default(cuid())
  quizId       String
  conceptId    String?
  text         String
  options      Json
  correctIndex Int
  explanation  String?
  type         QuestionType @default(SINGLE)
  concept      String?
  order        Int          @default(0)

  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  conceptRef  Concept?     @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  reviewItems ReviewItem[]

  @@index([quizId])
  @@index([concept])
  @@index([conceptId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  maxScore  Int
  answers   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([quizId])
  @@index([createdAt])
}

model OfficialExam {
  id           String       @id @default(cuid())
  subjectId    String
  year         Int
  session      ExamSession
  profile      Profile
  title        String
  pdfUrl       String
  solutionUrl  String?
  order        Int          @default(0)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, year, session, title])
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String   @unique
  keys         Json
  reminderTime String?
  timezone     String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model TodoItem {
  id        String   @id @default(cuid())
  userId    String
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Repetitie spatiata: un rand per intrebare gresita / de revizuit.
model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  failCount    Int      @default(1)
  successCount Int      @default(0)
  nextReviewAt DateTime @default(now())
  interval     Int      @default(1)
  ease         Float    @default(2.5)
  lastFailedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

// Un rând per zi în care utilizatorul a învățat (lecție completată sau test
// rezolvat). `date` este normalizat la începutul zilei (UTC), iar `count`
// numără câte acțiuni de studiu au avut loc în ziua respectivă.
model StudyActivity {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  count     Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}
