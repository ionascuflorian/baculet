generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AdminPermission {
  MANAGE_CONTENT
  MANAGE_QUIZZES
  MANAGE_EXAMS
  MANAGE_SITE_SETTINGS
  MANAGE_SITE_AI
  MANAGE_AI_CONTENT
  MANAGE_USERS
}

enum Profile {
  REAL
  HUMAN
  TECH
}

enum ExamSession {
  SUMMER
  AUTUMN
  SPECIAL
}

enum QuestionType {
  SINGLE
  CLOZE
  FLASHCARD
  DRAG_DROP
}

enum UnitType {
  LESSON
  RECAP
  CHECKPOINT
  DIAGNOSTIC
}

enum UnitStatusEnum {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  MASTERED
  NEEDS_REVIEW
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String?  @unique
  passwordHash  String
  name          String
  image         String?
  emailVerified DateTime?
  role          Role     @default(USER)
  isOwner       Boolean  @default(false)
  permissions   AdminPermission[] @default([])
  streakCount   Int      @default(0)
  lastActiveAt  DateTime?
  timezone      String?
  dashboardWidgets Json?
  weatherLocation Json?
  themeSlug     String?
  profile       Profile?
  emailNotifs   Boolean  @default(true)
  streakNotifs  Boolean  @default(true)
  followNotifs  Boolean  @default(true)
  termsAcceptedAt DateTime?
  onboardingDone Boolean @default(false)
  googleLinked  Boolean @default(false)
  googleEmail   String?  @unique
  pendingEmail  String?
  pendingEmailCode DateTime?
  pendingEmailExpires DateTime?
  reminderHour  Int?
  streakWarnedFor DateTime?
  reminderSentOn DateTime?
  aiProvider    String?
  aiApiKeyEnc   String?
  aiModel       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lessonProgress      LessonProgress[]
  lessonStepProgress  LessonStepProgress[]
  quizAttempts        QuizAttempt[]
  pushSubscriptions   PushSubscription[]
  calendarEvents      CalendarEvent[]
  quizzes             Quiz[]
  todoItems           TodoItem[]
  studyActivities     StudyActivity[]
  reviewItems         ReviewItem[]
  conceptProgress     UserConceptProgress[]
  unitProgress        UserUnitProgress[]
  checkpointAttempts  CheckpointAttempt[]
  following           Follow[] @relation("Follower")
  followers           Follow[] @relation("Following")
  uploadedSources     ContentSource[] @relation("UploadedSources")
  contentActivities   ProjectActivity[] @relation("ContentActivities")
}

// Urmărire unidirecțională: `follower` urmărește `following`.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  light       Json
  dark        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventKind {
  USER
  ACHIEVEMENT
  EXAM
}

model CalendarEvent {
  id        String    @id @default(cuid())
  userId    String
  title     String
  date      DateTime
color     String?
    kind      EventKind @default(USER)
    key       String?
    createdAt DateTime  @default(now())
  
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
    @@unique([userId, key])
    @@index([userId, date])
}

model Subject {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  color       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  chapters      Chapter[]
  quizzes       Quiz[]
  exams         OfficialExam[]
  subjectProfiles SubjectProfile[]
  contentProjects ContentProject[]
}

model SubjectProfile {
  id        String   @id @default(cuid())
  subjectId String
  profile   Profile

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, profile])
}

model Chapter {
  id          String  @id @default(cuid())
  subjectId   String
  title       String
  slug        String
  description String?
  order       Int     @default(0)

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  units   Unit[]
  quizzes Quiz[]
  checkpoints Checkpoint[]

  @@unique([subjectId, slug])
}

model Unit {
  id          String   @id @default(cuid())
  chapterId   String
  title       String
  slug        String
  description String?
  order       Int      @default(0)
  type        UnitType @default(LESSON)

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  concepts Concept[]
  checkpoint Checkpoint?
  progress UserUnitProgress[]

  @@unique([chapterId, slug])
  @@index([chapterId])
}

model Lesson {
  id        String  @id @default(cuid())
  chapterId String
  unitId    String?
  title     String
  slug      String
  content   String
  videoUrl  String?
  pdfUrl    String?
  order     Int     @default(0)
  difficulty Int    @default(1)

  chapter  Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  unit     Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  progress LessonProgress[]
  steps    LessonStep[]
  concepts Concept[]

  @@unique([chapterId, slug])
  @@index([unitId])
}

model LessonStep {
  id          String  @id @default(cuid())
  lessonId    String
  title       String?
  content     String
  order       Int     @default(0)
  stepType    String? // DESCOPERĂ, ÎNȚELEGE, EXEMPLU, ÎNCEARCĂ, EXERSEAZĂ, APLICĂ, RECAPITULEAZĂ
  quizId      String? @unique
  minReadTime Int     @default(15) // secunde minime pentru a marca secțiunea de teorie/exemplu ca citită
  manual      Boolean @default(false) // true = secțiune creată/editată în Constructor (nu e suprascrisă de sync din markdown)

  lesson   Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quiz     Quiz?           @relation(fields: [quizId], references: [id], onDelete: SetNull)
  progress LessonStepProgress[]

  @@unique([lessonId, order])
  @@index([lessonId])
}

model LessonStepProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  stepId    String
  completedAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  step LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId, lessonId])
  @@index([completedAt])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([completedAt])
}

model Concept {
  id          String  @id @default(cuid())
  lessonId    String?
  unitId      String?
  name        String
  slug        String
  description String?
  difficulty  Int     @default(1)
  order       Int     @default(0)

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  exercises Exercise[]
  questions Question[]
  progress  UserConceptProgress[]

  @@unique([lessonId, slug])
  @@unique([unitId, slug])
  @@index([lessonId])
  @@index([unitId])
}

model Exercise {
  id        String       @id @default(cuid())
  conceptId String
  type      QuestionType @default(SINGLE)
  difficulty Int         @default(1)
  content   Json
  answer    Json
  explanation String?
  order     Int          @default(0)
  createdAt DateTime     @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([conceptId])
}

model UserConceptProgress {
  id              String    @id @default(cuid())
  userId          String
  conceptId       String
  mastery         Int       @default(0)
  attempts        Int       @default(0)
  correctAttempts Int       @default(0)
  wrongAttempts   Int       @default(0)
  lastPracticed   DateTime?
  nextReview      DateTime?
  updatedAt       DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId, mastery])
  @@index([userId, nextReview])
}

model UserUnitProgress {
  id          String   @id @default(cuid())
  userId      String
  unitId      String
  status      String   @default("LOCKED")
  progress    Int      @default(0)
  score       Int?
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId])
}

model Checkpoint {
  id        String   @id @default(cuid())
  chapterId String? @unique
  unitId    String? @unique
  title     String
  slug      String  @unique
  order     Int     @default(0)
  createdAt DateTime @default(now())

  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  unit    Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  attempts CheckpointAttempt[]
}

model CheckpointAttempt {
  id           String   @id @default(cuid())
  userId       String
  checkpointId String
  score        Int
  maxScore     Int
  answers      Json
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([checkpointId])
}

model Quiz {
    id          String   @id @default(cuid())
    subjectId   String
    chapterId   String?
    userId      String?
    title       String
    slug        String
    description String?
    difficulty  Int      @default(1)
    published   Boolean  @default(true)
    order       Int      @default(0)
    createdAt   DateTime @default(now())
  
    subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
    chapter   Chapter?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
    user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    questions Question[]
    attempts  QuizAttempt[]
    step      LessonStep?
  
    @@index([userId])
    @@unique([subjectId, slug])
  }

model Question {
  id           String       @id @default(cuid())
  quizId       String
  conceptId    String?
  text         String
  options      Json
  correctIndex Int
  explanation  String?
  type         QuestionType @default(SINGLE)
  concept      String?
  order        Int          @default(0)

  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  conceptRef  Concept?     @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  reviewItems ReviewItem[]

  @@index([quizId])
  @@index([concept])
  @@index([conceptId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  maxScore  Int
  answers   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([quizId])
  @@index([createdAt])
}

model OfficialExam {
  id           String       @id @default(cuid())
  subjectId    String
  year         Int
  session      ExamSession
  profile      Profile
  title        String
  pdfUrl       String
  solutionUrl  String?
  order        Int          @default(0)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, year, session, title])
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String   @unique
  keys         Json
  reminderTime String?
  timezone     String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model TodoItem {
  id        String   @id @default(cuid())
  userId    String
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Repetitie spatiata: un rand per intrebare gresita / de revizuit.
model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  failCount    Int      @default(1)
  successCount Int      @default(0)
  nextReviewAt DateTime @default(now())
  interval     Int      @default(1)
  ease         Float    @default(2.5)
  lastFailedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

// Un rând per zi în care utilizatorul a învățat (lecție completată sau test
// rezolvat). `date` este normalizat la începutul zilei (UTC), iar `count`
// numără câte acțiuni de studiu au avut loc în ziua respectivă.
model StudyActivity {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  count     Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Băculeț Content Studio (AI Content) — modele de STAGING.
//
// Aceste modele NU sunt conținut educațional live. Ele reprezintă un workflow
// de producție: proiecte de conținut, surse analizate, planuri de curriculum
// draft, draft-uri de lecții/quiz-uri/checkpoint-uri și jobs de generare.
// Publicarea copiază draft-urile aprobate în modelele educaționale existente
// (Subject/Chapter/Unit/Lesson/LessonStep/Concept/Quiz/Question/Checkpoint).
// ─────────────────────────────────────────────────────────────────────────────

// Workflow partajat între proiect și itemi. Pentru proiect: DRAFT/ANALYZING/
// READY_FOR_REVIEW marchează faza de analiză a surselor; GENERATING/VALIDATING/
// NEEDS_REVIEW/APPROVED/PUBLISHED marchează producția. FAILED la fel pentru ambele.
enum ContentWorkflowStatus {
  DRAFT
  ANALYZING
  READY_FOR_REVIEW
  GENERATING
  VALIDATING
  NEEDS_REVIEW
  APPROVED
  PUBLISHED
  FAILED
}

enum ContentSourceStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum SourcePriority {
  OFFICIAL
  HIGH
  NORMAL
  REFERENCE
}

enum CurriculumNodeKind {
  CHAPTER
  UNIT
  CONCEPT
}

enum ContentItemType {
  LESSON
  QUIZ
  CHECKPOINT
}

enum GenerationJobKind {
  SOURCE_PROCESS
  CURRICULUM
  LESSON
  QUIZ
  CHECKPOINT
  VALIDATION
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model ContentProject {
  id          String                @id @default(cuid())
  name        String
  subjectId   String
  bacYear     Int?
  examType    String? // SUMMER / AUTUMN / SPECIAL (per sesiune BAC)
  description String?
  status      ContentWorkflowStatus @default(DRAFT)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  subject    Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sources    ContentSource[]
  nodes      CurriculumNode[]
  items      ContentItem[]
  jobs       GenerationJob[]
  activities ProjectActivity[]
  chunks     ContentChunk[]

  @@index([subjectId])
  @@index([status])
}

model ContentSource {
  id           String             @id @default(cuid())
  projectId    String
  originalName String
  storageKey   String // url semnat Vercel Blob
  mime         String // application/pdf, application/vnd.openxmlformats-officedocument.wordprocessingml.document, text/plain, text/markdown
  size         Int
  priority     SourcePriority     @default(NORMAL)
  status       ContentSourceStatus @default(UPLOADED)
  pageCount    Int?
  charCount    Int?
  error        String?
  uploadedById String? // admin care a urcat sursa
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  project    ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?          @relation("UploadedSources", fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks     ContentChunk[]

  @@index([projectId])
  @@index([status])
}

model ContentChunk {
  id         String   @id @default(cuid())
  sourceId   String
  projectId  String // denormalizat pentru căutare rapidă pe proiect
  page       Int?
  section    String?
  text       String
  tokenCount Int?
  embedding  Json? // vector Float[] pt. cosine similarity
  createdAt  DateTime @default(now())

  source  ContentSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  project ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sourceId])
  @@index([page])
}

model CurriculumNode {
  id          String             @id @default(cuid())
  projectId   String
  kind        CurriculumNodeKind
  parentId    String? // arbore: Chapter → Unit → Concept
  title       String
  slug        String?
  description String?
  order       Int                @default(0)
  evidence    Json? // [{ sourceId, page, chunkId }] — de unde provine
  mappedId    String? // id-ul obiectului live (Chapter/Unit/Concept) dacă s-a făcut dedupe
  manual      Boolean            @default(false) // editările manuale supraviețuiesc regenerărilor
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project  ContentProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   CurriculumNode?   @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children CurriculumNode[]  @relation("NodeTree")
  items    ContentItem[]

  @@index([projectId, parentId])
  @@index([projectId, kind])
}

model ContentItem {
  id                 String               @id @default(cuid())
  projectId          String
  nodeId             String? // CurriculumNode (unit/chapter) căreia aparține
  type               ContentItemType
  status             ContentWorkflowStatus @default(DRAFT)
  title              String
  draft              Json // payload tipărit: lesson { steps[] }, quiz { questions[] }, checkpoint { title, quizTitle, questions[] }
  validation         Json? // rezultatul validatorului AI (score, issues, suggestions)
  version            Int                  @default(1)
  versions           Json                 @default("[]") // [{ version, at, draft, note }]
  sourceRefs         Json                 @default("[]") // [{ sourceId, page, chunkId }]
  note               String? // nota admin
  targetChapterId    String? // unde a ajuns la publish
  targetUnitId       String?
  targetLessonId     String?
  targetQuizId       String?
  targetCheckpointId String?
  publishedAt        DateTime?
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  project ContentProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node    CurriculumNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  jobs    GenerationJob[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([nodeId])
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  project ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User           @relation("ContentActivities", fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model GenerationJob {
  id         String               @id @default(cuid())
  projectId  String?
  itemId     String? // ContentItem legat (kind LESSON/QUIZ/CHECKPOINT/VALIDATION)
  userId     String
  kind       GenerationJobKind
  status     GenerationJobStatus @default(QUEUED)
  params     Json
  result     Json?
  error      String?
  attempts   Int                  @default(0) // max 2 retry pe erori tranzitorii
  createdAt  DateTime             @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  project ContentProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item    ContentItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
}
